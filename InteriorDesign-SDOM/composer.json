{
  "name": "student/interior-design-website",
  "description": "Interior design portfolio and consultation website",
  "type": "project",
  "require": {
    "php": "^8.2",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {"App\\": "src/"}
  },
  "autoload-dev": {
    "psr-4": {"Tests\\": "tests/"}
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-text",
    "audit": "composer audit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
